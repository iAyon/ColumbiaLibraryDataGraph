// Columbia Library Knowledge Graph Seed Queries (OpenCypher / Neo4j / AWS Neptune)

CREATE (d:Dataset {id: 'clio_965_numeric', title: 'Numeric Data Collection (965DataGate)', platform: 'CLIO Catalog', access_level: 'Columbia-Licensed'});
