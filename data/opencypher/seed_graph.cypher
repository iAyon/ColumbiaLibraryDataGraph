// Columbia Library Knowledge Graph Seed Queries (OpenCypher / Neo4j / AWS Neptune)

CREATE (d:Dataset {id: 'clio_965_poll2020', title: 'Public Opinion Poll Data 2020 (965DataGate)', platform: 'CLIO Catalog', access_level: 'Columbia-Licensed'});
CREATE (d:Dataset {id: 'clio_965_numeric', title: 'Numeric Data Collection (965DataGate)', platform: 'CLIO Catalog', access_level: 'Columbia-Licensed'});
CREATE (d:Dataset {id: 'open_nasa_earth', title: 'NASA Earth Science & Climate Open Datasets', platform: 'Open Source Repository', access_level: 'Open Access'});
CREATE (d:Dataset {id: 'cdp_hcup', title: 'HCUP Healthcare Cost and Utilization Project', platform: 'Redivis (Columbia Data Platform)', access_level: 'Restricted'});
CREATE (d:Dataset {id: 'cdp_l2_voter', title: 'L2 Micro-Level Election Voter Data', platform: 'Redivis (Columbia Data Platform)', access_level: 'Restricted'});
CREATE (d:Dataset {id: 'cdp_ipums_census', title: 'IPUMS Restricted Access Full Count US Census (1790-1950)', platform: 'Redivis (Columbia Data Platform)', access_level: 'Restricted'});
CREATE (d:Dataset {id: 'cdp_geospatial_eric', title: 'Licensed Geospatial & Spatial Analytics Datasets', platform: 'Redivis (Columbia Data Platform)', access_level: 'Columbia-Licensed'});
CREATE (d:Dataset {id: 'cdp_text_moacir', title: 'Textual & Computational Linguistics Corpus', platform: 'Redivis (Columbia Data Platform)', access_level: 'Columbia-Licensed'});
CREATE (l:Libguide {id: 'lg_international_sipa', title: 'International Data Guide', program: 'SIPA MPA-ESP'});
CREATE (l:Libguide {id: 'lg_datatools_med', title: 'Data Analysis Tools Guide', program: 'Medical Campus'});
CREATE (l:Libguide {id: 'lg_numeric_data', title: 'Numeric Data Collection Guide', program: 'Research Data Services (RDS)'});
CREATE (l:Libguide {id: 'lg_election_opinion', title: 'Public Opinion Poll & Election Data Guide', program: 'Political Science & CPRC'});
CREATE (p:Platform {id: 'platform_clio_catalog', name: 'CLIO Catalog'});
CREATE (p:Platform {id: 'platform_open_source_repository', name: 'Open Source Repository'});
CREATE (p:Platform {id: 'platform_redivis_(columbia_data_platform)', name: 'Redivis (Columbia Data Platform)'});
CREATE (s:SubjectSpecialist {id: 'spec_jeremiah', name: 'Jeremiah'});
CREATE (s:SubjectSpecialist {id: 'spec_jeremiah & ashley (cprc / cuit)', name: 'Jeremiah & Ashley (CPRC / CUIT)'});
CREATE (s:SubjectSpecialist {id: 'spec_eric', name: 'Eric'});
CREATE (s:SubjectSpecialist {id: 'spec_moacir', name: 'Moacir'});
MATCH (d:Dataset {id: 'clio_965_poll2020'}), (p:Platform {id: 'platform_clio_catalog'}) CREATE (d)-[:HOSTED_ON]->(p);
MATCH (d:Dataset {id: 'clio_965_numeric'}), (p:Platform {id: 'platform_clio_catalog'}) CREATE (d)-[:HOSTED_ON]->(p);
MATCH (d:Dataset {id: 'open_nasa_earth'}), (p:Platform {id: 'platform_open_source_repository'}) CREATE (d)-[:HOSTED_ON]->(p);
MATCH (d:Dataset {id: 'cdp_hcup'}), (p:Platform {id: 'platform_redivis_(columbia_data_platform)'}) CREATE (d)-[:HOSTED_ON]->(p);
MATCH (d:Dataset {id: 'cdp_hcup'}), (s:SubjectSpecialist {id: 'spec_jeremiah'}) CREATE (d)-[:MANAGED_BY]->(s);
MATCH (d:Dataset {id: 'cdp_l2_voter'}), (p:Platform {id: 'platform_redivis_(columbia_data_platform)'}) CREATE (d)-[:HOSTED_ON]->(p);
MATCH (d:Dataset {id: 'cdp_l2_voter'}), (s:SubjectSpecialist {id: 'spec_jeremiah & ashley (cprc / cuit)'}) CREATE (d)-[:MANAGED_BY]->(s);
MATCH (d:Dataset {id: 'cdp_ipums_census'}), (p:Platform {id: 'platform_redivis_(columbia_data_platform)'}) CREATE (d)-[:HOSTED_ON]->(p);
MATCH (d:Dataset {id: 'cdp_ipums_census'}), (s:SubjectSpecialist {id: 'spec_jeremiah & ashley (cprc / cuit)'}) CREATE (d)-[:MANAGED_BY]->(s);
MATCH (d:Dataset {id: 'cdp_geospatial_eric'}), (p:Platform {id: 'platform_redivis_(columbia_data_platform)'}) CREATE (d)-[:HOSTED_ON]->(p);
MATCH (d:Dataset {id: 'cdp_geospatial_eric'}), (s:SubjectSpecialist {id: 'spec_eric'}) CREATE (d)-[:MANAGED_BY]->(s);
MATCH (d:Dataset {id: 'cdp_text_moacir'}), (p:Platform {id: 'platform_redivis_(columbia_data_platform)'}) CREATE (d)-[:HOSTED_ON]->(p);
MATCH (d:Dataset {id: 'cdp_text_moacir'}), (s:SubjectSpecialist {id: 'spec_moacir'}) CREATE (d)-[:MANAGED_BY]->(s);
