# Columbia Library Data Graph Environment Configuration

# Application Server Port
PORT=5000

# AWS Neptune Configuration
NEPTUNE_ENDPOINT=https://your-neptune-cluster.cluster-xyz.us-east-1.neptune.amazonaws.com:8182

# Redivis API Configuration (columbia.redivis.com)
REDIVIS_API_TOKEN=your_redivis_api_token_here

# HuggingFace Token (Optional for higher rate limits)
HF_TOKEN=your_huggingface_token_here

# LLM Compute Provider Configuration
COMPUTE_MODE=Cloud LLM (OpenAI GPT-4 / AWS Bedrock)
OPENAI_API_KEY=your_openai_api_key_here
